# Database Configuration
POSTGRES_USER=dirs_user
POSTGRES_PASSWORD=REPLACE_WITH_LOCAL_DB_PASSWORD
POSTGRES_DB=dirs_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://dirs_user:REPLACE_WITH_LOCAL_DB_PASSWORD@postgres:5432/dirs_db

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# Backend Configuration
SECRET_KEY=REPLACE_WITH_RANDOM_SECRET_KEY
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Media Storage
MEDIA_UPLOAD_DIR=app/static/uploads

# AI & LLM Configuration (Optional API keys)
OPENAI_API_KEY=
GEMINI_API_KEY=
