# ==============================================================================
# DIRS (Disaster Intelligence and Response System) — Environment Configuration Template
# DO NOT COMMIT ACTUAL SECRETS TO VERSION CONTROL
# ==============================================================================

# System Environment Mode
# Options: development | test | staging | production
ENVIRONMENT=development
PROJECT_NAME="DIRS — Disaster Intelligence and Response System"
API_V1_STR=/api/v1

# Security & Cryptography
# In staging/production, SECRET_KEY must be >= 32 characters and NOT the default string
SECRET_KEY=REPLACE_WITH_RANDOM_SECRET_KEY
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# BENEFICIARY_HASH_SALT must be at least 16 characters in staging/production for privacy hashing
BENEFICIARY_HASH_SALT=REPLACE_WITH_RANDOM_BENEFICIARY_SALT

# Request Body Limit (in bytes, default 10MB = 10485760)
MAX_REQUEST_BODY_BYTES=10485760

# Allowed CORS Origins (Comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:3000,http://127.0.0.1:3000

# Primary PostgreSQL Database
DATABASE_URL=postgresql://dirs_user:REPLACE_WITH_LOCAL_DB_PASSWORD@localhost:5432/dirs_db

# Redis Cache / Message Broker (Optional, falls back to in-memory idempotency store)
REDIS_URL=redis://localhost:6379/0
